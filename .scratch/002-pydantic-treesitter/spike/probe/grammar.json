{
  "name": "spike",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {"type": "SYMBOL", "name": "statement"}
    },
    "statement": {
      "type": "CHOICE",
      "members": [
        {"type": "SYMBOL", "name": "expr_statement"},
        {"type": "SYMBOL", "name": "if_statement"}
      ]
    },
    "expr_statement": {"type": "SYMBOL", "name": "expr"},
    "if_statement": {
      "type": "SEQ",
      "members": [
        {"type": "STRING", "value": "if"},
        {"type": "SYMBOL", "name": "expr"},
        {"type": "SYMBOL", "name": "statement"},
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {"type": "STRING", "value": "else"},
                {"type": "SYMBOL", "name": "statement"}
              ]
            },
            {"type": "BLANK"}
          ]
        }
      ]
    },
    "expr": {
      "type": "CHOICE",
      "members": [
        {"type": "PREC_LEFT", "value": 1, "content": {"type": "SEQ", "members": [{"type": "SYMBOL", "name": "expr"}, {"type": "STRING", "value": "+"}, {"type": "SYMBOL", "name": "expr"}]}},
        {"type": "PREC_LEFT", "value": 1, "content": {"type": "SEQ", "members": [{"type": "SYMBOL", "name": "expr"}, {"type": "STRING", "value": "-"}, {"type": "SYMBOL", "name": "expr"}]}},
        {"type": "PREC_LEFT", "value": 2, "content": {"type": "SEQ", "members": [{"type": "SYMBOL", "name": "expr"}, {"type": "STRING", "value": "*"}, {"type": "SYMBOL", "name": "expr"}]}},
        {"type": "PREC_LEFT", "value": 2, "content": {"type": "SEQ", "members": [{"type": "SYMBOL", "name": "expr"}, {"type": "STRING", "value": "/"}, {"type": "SYMBOL", "name": "expr"}]}},
        {"type": "PREC_RIGHT", "value": 3, "content": {"type": "SEQ", "members": [{"type": "SYMBOL", "name": "expr"}, {"type": "STRING", "value": "^"}, {"type": "SYMBOL", "name": "expr"}]}},
        {"type": "PREC", "value": 4, "content": {"type": "SEQ", "members": [{"type": "STRING", "value": "-"}, {"type": "SYMBOL", "name": "expr"}]}},
        {"type": "SYMBOL", "name": "atom"}
      ]
    },
    "atom": {
      "type": "CHOICE",
      "members": [
        {"type": "SYMBOL", "name": "number"},
        {"type": "SYMBOL", "name": "identifier"},
        {"type": "SEQ", "members": [{"type": "STRING", "value": "("}, {"type": "SYMBOL", "name": "expr"}, {"type": "STRING", "value": ")"}]}
      ]
    },
    "number": {"type": "PATTERN", "value": "\\d+(\\.\\d+)?"},
    "identifier": {"type": "PATTERN", "value": "[a-zA-Z_][a-zA-Z0-9_]*"}
  },
  "extras": [
    {"type": "PATTERN", "value": "\\s"},
    {"type": "PATTERN", "value": "//[^\\n]*"},
    {"type": "PATTERN", "value": "/\\*([^*]|\\*[^/])*\\*/"}
  ],
  "word": "identifier"
}

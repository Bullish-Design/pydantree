{
  "name": "c2_dangling",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "statement"
      }
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-zA-Z_]\\w*"
    },
    "expr": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "PATTERN",
          "value": "\\d+"
        }
      ]
    },
    "if_stmt": {
      "type": "PREC_DYNAMIC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "if"
          },
          {
            "type": "FIELD",
            "name": "cond",
            "content": {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "("
                },
                {
                  "type": "SYMBOL",
                  "name": "expr"
                },
                {
                  "type": "STRING",
                  "value": ")"
                }
              ]
            }
          },
          {
            "type": "FIELD",
            "name": "then",
            "content": {
              "type": "SYMBOL",
              "name": "statement"
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "else"
                  },
                  {
                    "type": "FIELD",
                    "name": "else",
                    "content": {
                      "type": "SYMBOL",
                      "name": "statement"
                    }
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "expr_stmt": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "expr"
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "if_stmt"
        },
        {
          "type": "SYMBOL",
          "name": "expr_stmt"
        }
      ]
    }
  },
  "precedences": [],
  "conflicts": [
    [
      "if_stmt"
    ]
  ],
  "externals": [],
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "inline": [],
  "supertypes": [
    "statement"
  ],
  "word": "identifier",
  "reserved": {}
}
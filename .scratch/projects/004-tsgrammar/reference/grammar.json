{
  "name": "kitsink",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": { "type": "SYMBOL", "name": "statement" }
    },
    "statement": {
      "type": "CHOICE",
      "members": [
        { "type": "SYMBOL", "name": "let_stmt" },
        { "type": "SYMBOL", "name": "fn_stmt" },
        { "type": "SYMBOL", "name": "import_stmt" },
        { "type": "SYMBOL", "name": "if_stmt" },
        { "type": "SYMBOL", "name": "label_stmt" },
        { "type": "SYMBOL", "name": "expr_statement" },
        { "type": "SYMBOL", "name": "ext_stmt" }
      ]
    },
    "let_stmt": {
      "type": "SEQ",
      "members": [
        { "type": "STRING", "value": "let" },
        { "type": "FIELD", "name": "name", "content": { "type": "SYMBOL", "name": "identifier" } },
        { "type": "STRING", "value": "=" },
        { "type": "FIELD", "name": "value", "content": { "type": "SYMBOL", "name": "expr" } }
      ]
    },
    "fn_stmt": {
      "type": "SEQ",
      "members": [
        { "type": "STRING", "value": "fn" },
        { "type": "FIELD", "name": "name", "content": { "type": "SYMBOL", "name": "identifier" } },
        { "type": "STRING", "value": "(" },
        {
          "type": "CHOICE",
          "members": [
            { "type": "SYMBOL", "name": "params" },
            { "type": "BLANK" }
          ]
        },
        { "type": "STRING", "value": ")" },
        { "type": "FIELD", "name": "body", "content": { "type": "SYMBOL", "name": "block" } }
      ]
    },
    "params": {
      "type": "SEQ",
      "members": [
        { "type": "FIELD", "name": "param", "content": { "type": "SYMBOL", "name": "identifier" } },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              { "type": "STRING", "value": "," },
              { "type": "FIELD", "name": "param", "content": { "type": "SYMBOL", "name": "identifier" } }
            ]
          }
        }
      ]
    },
    "block": {
      "type": "SEQ",
      "members": [
        { "type": "STRING", "value": "{" },
        { "type": "REPEAT", "content": { "type": "SYMBOL", "name": "statement" } },
        { "type": "STRING", "value": "}" }
      ]
    },
    "import_stmt": {
      "type": "SEQ",
      "members": [
        { "type": "STRING", "value": "import" },
        { "type": "FIELD", "name": "module", "content": { "type": "SYMBOL", "name": "identifier" } },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SEQ",
            "members": [
              { "type": "STRING", "value": "," },
              { "type": "FIELD", "name": "module", "content": { "type": "SYMBOL", "name": "identifier" } }
            ]
          }
        }
      ]
    },
    "if_stmt": {
      "type": "PREC_DYNAMIC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          { "type": "STRING", "value": "if" },
          { "type": "FIELD", "name": "cond", "content": { "type": "SYMBOL", "name": "expr" } },
          { "type": "FIELD", "name": "then", "content": { "type": "SYMBOL", "name": "statement" } },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  { "type": "STRING", "value": "else" },
                  { "type": "FIELD", "name": "else", "content": { "type": "SYMBOL", "name": "statement" } }
                ]
              },
              { "type": "BLANK" }
            ]
          }
        ]
      }
    },
    "label_stmt": {
      "type": "SEQ",
      "members": [
        { "type": "SYMBOL", "name": "identifier" },
        { "type": "IMMEDIATE_TOKEN", "content": { "type": "STRING", "value": ":" } },
        { "type": "SYMBOL", "name": "statement" }
      ]
    },
    "expr_statement": {
      "type": "SEQ",
      "members": [
        { "type": "SYMBOL", "name": "expr" },
        { "type": "SYMBOL", "name": "semicolon" }
      ]
    },
    "semicolon": { "type": "STRING", "value": ";" },
    "ext_stmt": {
      "type": "SEQ",
      "members": [
        { "type": "SYMBOL", "name": "TERM" },
        { "type": "SYMBOL", "name": "expr" }
      ]
    },
    "expr": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PREC_LEFT",
          "value": "or",
          "content": {
            "type": "SEQ",
            "members": [
              { "type": "SYMBOL", "name": "expr" },
              { "type": "STRING", "value": "or" },
              { "type": "SYMBOL", "name": "expr" }
            ]
          }
        },
        {
          "type": "PREC_LEFT",
          "value": "and",
          "content": {
            "type": "SEQ",
            "members": [
              { "type": "SYMBOL", "name": "expr" },
              { "type": "STRING", "value": "and" },
              { "type": "SYMBOL", "name": "expr" }
            ]
          }
        },
        { "type": "SYMBOL", "name": "_arith" }
      ]
    },
    "_arith": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PREC_LEFT",
          "value": 1,
          "content": {
            "type": "SEQ",
            "members": [
              { "type": "SYMBOL", "name": "_arith" },
              { "type": "STRING", "value": "+" },
              { "type": "SYMBOL", "name": "_arith" }
            ]
          }
        },
        {
          "type": "PREC_LEFT",
          "value": 1,
          "content": {
            "type": "SEQ",
            "members": [
              { "type": "SYMBOL", "name": "_arith" },
              { "type": "STRING", "value": "-" },
              { "type": "SYMBOL", "name": "_arith" }
            ]
          }
        },
        {
          "type": "PREC_LEFT",
          "value": 2,
          "content": {
            "type": "SEQ",
            "members": [
              { "type": "SYMBOL", "name": "_arith" },
              { "type": "STRING", "value": "*" },
              { "type": "SYMBOL", "name": "_arith" }
            ]
          }
        },
        {
          "type": "PREC_LEFT",
          "value": 2,
          "content": {
            "type": "SEQ",
            "members": [
              { "type": "SYMBOL", "name": "_arith" },
              { "type": "STRING", "value": "/" },
              { "type": "SYMBOL", "name": "_arith" }
            ]
          }
        },
        {
          "type": "PREC_RIGHT",
          "value": 3,
          "content": {
            "type": "SEQ",
            "members": [
              { "type": "SYMBOL", "name": "_arith" },
              { "type": "STRING", "value": "^" },
              { "type": "SYMBOL", "name": "_arith" }
            ]
          }
        },
        {
          "type": "PREC",
          "value": 4,
          "content": {
            "type": "SEQ",
            "members": [
              { "type": "STRING", "value": "-" },
              { "type": "SYMBOL", "name": "_arith" }
            ]
          }
        },
        { "type": "SYMBOL", "name": "atom" }
      ]
    },
    "atom": {
      "type": "CHOICE",
      "members": [
        { "type": "SYMBOL", "name": "number" },
        { "type": "SYMBOL", "name": "hex" },
        { "type": "SYMBOL", "name": "string" },
        { "type": "SYMBOL", "name": "identifier" },
        { "type": "SYMBOL", "name": "call" },
        { "type": "SYMBOL", "name": "object" },
        {
          "type": "SEQ",
          "members": [
            { "type": "STRING", "value": "(" },
            { "type": "SYMBOL", "name": "expr" },
            { "type": "STRING", "value": ")" }
          ]
        },
        { "type": "SYMBOL", "name": "_tuple" }
      ]
    },
    "object": {
      "type": "SEQ",
      "members": [
        { "type": "STRING", "value": "{" },
        {
          "type": "CHOICE",
          "members": [
            { "type": "SYMBOL", "name": "member" },
            { "type": "BLANK" }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              { "type": "STRING", "value": "," },
              { "type": "SYMBOL", "name": "member" }
            ]
          }
        },
        { "type": "STRING", "value": "}" }
      ]
    },
    "member": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "key",
          "content": {
            "type": "RESERVED",
            "context_name": "property",
            "content": { "type": "SYMBOL", "name": "identifier" }
          }
        },
        { "type": "STRING", "value": ":" },
        {
          "type": "FIELD",
          "name": "value",
          "content": { "type": "SYMBOL", "name": "expr" }
        }
      ]
    },
    "call": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          { "type": "SYMBOL", "name": "identifier" },
          { "type": "STRING", "value": "(" },
          {
            "type": "CHOICE",
            "members": [
              { "type": "SYMBOL", "name": "args" },
              { "type": "BLANK" }
            ]
          },
          { "type": "STRING", "value": ")" }
        ]
      }
    },
    "args": {
      "type": "SEQ",
      "members": [
        { "type": "FIELD", "name": "arg", "content": { "type": "SYMBOL", "name": "expr" } },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              { "type": "STRING", "value": "," },
              { "type": "FIELD", "name": "arg", "content": { "type": "SYMBOL", "name": "expr" } }
            ]
          }
        }
      ]
    },
    "_tuple": {
      "type": "ALIAS",
      "value": "tuple",
      "named": true,
      "content": { "type": "SYMBOL", "name": "_tuple_contents" }
    },
    "_tuple_contents": {
      "type": "SEQ",
      "members": [
        { "type": "STRING", "value": "(" },
        { "type": "SYMBOL", "name": "expr" },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SEQ",
            "members": [
              { "type": "STRING", "value": "," },
              { "type": "SYMBOL", "name": "expr" }
            ]
          }
        },
        { "type": "STRING", "value": ")" }
      ]
    },
    "number": { "type": "PATTERN", "value": "\\d+(\\.\\d+)?" },
    "hex": { "type": "PATTERN", "value": "0x[0-9a-f]+", "flags": "i" },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          { "type": "STRING", "value": "\"" },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                { "type": "PATTERN", "value": "\\\\." },
                { "type": "PATTERN", "value": "[^\"\\\\]+" }
              ]
            }
          },
          { "type": "STRING", "value": "\"" }
        ]
      }
    },
    "identifier": { "type": "PATTERN", "value": "[a-zA-Z_][a-zA-Z0-9_]*" },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              { "type": "STRING", "value": "//" },
              { "type": "PATTERN", "value": "[^\\n]*" }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              { "type": "STRING", "value": "/*" },
              { "type": "PATTERN", "value": "[^*]*\\*+([^/*][^*]*\\*+)*" },
              { "type": "STRING", "value": "/" }
            ]
          }
        ]
      }
    }
  },
  "precedences": [
    [
      { "type": "STRING", "value": "and" },
      { "type": "STRING", "value": "or" }
    ]
  ],
  "conflicts": [["if_stmt"]],
  "externals": [{ "type": "SYMBOL", "name": "TERM" }],
  "extras": [
    { "type": "PATTERN", "value": "\\s" },
    { "type": "SYMBOL", "name": "comment" }
  ],
  "inline": ["params", "member"],
  "supertypes": ["statement"],
  "word": "identifier",
  "reserved": {
    "global": [
      { "type": "STRING", "value": "if" }
    ],
    "property": []
  }
}
